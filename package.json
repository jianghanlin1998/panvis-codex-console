{
  "name": "panvis-codex-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.16.0 <12.0.0"
  },
  "scripts": {
    "build": "tsc -b packages/shared/tsconfig.build.json packages/domain/tsconfig.build.json packages/storage/tsconfig.build.json packages/codex-adapter/tsconfig.build.json packages/local-control/tsconfig.build.json --pretty false",
    "ctc:daemon": "pnpm build && node packages/local-control/dist/daemon-cli.js",
    "ctc:operator": "pnpm build && node packages/local-control/dist/operator-cli.js",
    "codex:runtime:install": "./scripts/install-owned-codex-runtime.sh",
    "codex:schema:generate": "tsc -p packages/codex-adapter/tsconfig.build.json --pretty false && node packages/codex-adapter/dist/generate-schema-cli.js",
    "lint": "eslint . --max-warnings 0",
    "public:check": "./scripts/check-public-repo-hygiene.sh",
    "test": "vitest run",
    "test:local-control:e2e": "node packages/local-control/test/executable-e2e.mjs",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
