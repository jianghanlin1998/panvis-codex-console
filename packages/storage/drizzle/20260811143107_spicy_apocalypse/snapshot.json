      "entityType": "checks",
      "table": "subtask_implementation_checkpoints"
    },
    {
      "value": "length(\"repository_commit_sha\") in (40, 64)\n        and \"repository_commit_sha\" not glob '*[^0-9a-f]*'",
      "name": "subtask_implementation_checkpoints_sha_check",
      "entityType": "checks",
      "table": "subtask_implementation_checkpoints"
    },
    {
      "value": "\"actor_type\" in ('HUMAN', 'CODEX', 'SYSTEM')",
      "name": "subtask_implementation_checkpoints_actor_type_check",
      "entityType": "checks",
      "table": "subtask_implementation_checkpoints"
    },
    {
      "value": "\"actor_reference\" is null or length(trim(\"actor_reference\")) between 1 and 256",
      "name": "subtask_implementation_checkpoints_actor_reference_length_check",
      "entityType": "checks",
      "table": "subtask_implementation_checkpoints"
    },
    {
      "value": "length(trim(\"source_reference\")) between 1 and 2048",
      "name": "subtask_implementation_checkpoints_source_reference_length_check",
