      "table": "subtask_implementation_checkpoints"
    },
    {
      "value": "length(trim(\"summary\")) between 1 and 1000",
      "name": "subtask_implementation_checkpoints_summary_length_check",
      "entityType": "checks",
      "table": "subtask_implementation_checkpoints"
    },
    {
      "value": "\"status\" in ('TODO', 'IN_PROGRESS', 'QA_DEBUG', 'DONE', 'DROPPED', 'ARCHIVED')",
      "name": "subtasks_status_check",
      "entityType": "checks",
      "table": "subtasks"
    },
    {
      "value": "\"maturity\" in ('NOT_STARTED', 'IMPLEMENTED', 'HARDENED', 'ACCEPTED')",
