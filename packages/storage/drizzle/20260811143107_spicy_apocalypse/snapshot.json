    {
      "value": "(\"big_task_id\" is null and \"subtask_id\" is null)\n        or (\"big_task_id\" is not null and \"subtask_id\" is null)\n        or (\"big_task_id\" is not null and \"subtask_id\" is not null)",
      "name": "audit_events_scope_check",
      "entityType": "checks",
      "table": "audit_events"
    },
    {
      "value": "length(trim(\"event_type\")) between 1 and 64\n        and \"event_type\" glob '[A-Z]*'\n        and \"event_type\" not glob '*[^A-Z0-9_]*'",
      "name": "audit_events_event_type_check",
      "entityType": "checks",
      "table": "audit_events"
    },
    {
      "value": "\"actor_type\" in ('HUMAN', 'CODEX', 'SYSTEM')",
      "name": "audit_events_actor_type_check",
      "entityType": "checks",
      "table": "audit_events"
    },
    {
      "value": "\"actor_reference\" is null or length(trim(\"actor_reference\")) between 1 and 256",
      "name": "audit_events_actor_reference_length_check",
      "entityType": "checks",
      "table": "audit_events"
    },
    {
      "value": "length(trim(\"summary\")) between 1 and 1000",
      "name": "audit_events_summary_length_check",
      "entityType": "checks",
      "table": "audit_events"
    },
    {
      "value": "\"subject_reference\" is null or length(trim(\"subject_reference\")) between 1 and 512",
      "name": "audit_events_subject_reference_length_check",
      "entityType": "checks",
      "table": "audit_events"
    },
    {
      "value": "\"status\" in ('IN_PROGRESS', 'DONE')",
      "name": "big_tasks_status_check",
      "entityType": "checks",
      "table": "big_tasks"
    },
    {
      "value": "(\"big_task_id\" is null and \"subtask_id\" is null)\n        or (\"big_task_id\" is not null and \"subtask_id\" is null)\n        or (\"big_task_id\" is not null and \"subtask_id\" is not null)",
      "name": "context_digests_scope_check",
      "entityType": "checks",
      "table": "context_digests"
    },
    {
      "value": "\"source_type\" in ('CHAT_MESSAGE', 'REPO', 'HANDOFF', 'IMPORT', 'MANUAL', 'SYSTEM')",
      "name": "context_digests_source_type_check",
      "entityType": "checks",
      "table": "context_digests"
    },
    {
      "value": "length(trim(\"body\")) between 1 and 8000",
      "name": "context_digests_body_length_check",
      "entityType": "checks",
      "table": "context_digests"
    },
    {
      "value": "length(trim(\"source_reference\")) between 1 and 2048",
      "name": "context_digests_source_reference_length_check",
      "entityType": "checks",
      "table": "context_digests"
    },
    {
      "value": "\"kind\" in ('DECISION', 'REQUIREMENT', 'CONSTRAINT', 'ENGINEERING_FACT', 'OPEN_QUESTION', 'RISK')",
      "name": "context_items_kind_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "\"status\" in ('PROPOSED', 'ACTIVE', 'SUPERSEDED', 'REJECTED', 'RESOLVED')",
      "name": "context_items_status_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "\"authority\" in ('HUMAN', 'REPO_EVIDENCE', 'CODEX_CANDIDATE', 'SYSTEM')",
      "name": "context_items_authority_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "\"source_type\" in ('CHAT_MESSAGE', 'REPO', 'HANDOFF', 'IMPORT', 'MANUAL', 'SYSTEM')",
      "name": "context_items_source_type_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "\"subtask_id\" is null or \"big_task_id\" is not null",
      "name": "context_items_scope_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "\"supersedes_context_item_id\" is null or \"id\" <> \"supersedes_context_item_id\"",
      "name": "context_items_no_self_supersession_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "length(trim(\"title\")) between 1 and 256",
      "name": "context_items_title_length_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "length(trim(\"body\")) between 1 and 4000",
      "name": "context_items_body_length_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "length(trim(\"source_reference\")) between 1 and 2048",
      "name": "context_items_source_reference_length_check",
      "entityType": "checks",
      "table": "context_items"
    },
    {
      "value": "\"repository_kind\" in ('PATH', 'REFERENCE')",
      "name": "projects_repository_kind_check",
      "entityType": "checks",
      "table": "projects"
    },
    {
      "value": "\"max_active_coding_subtasks\" between 1 and 2",
      "name": "projects_max_active_coding_subtasks_check",
      "entityType": "checks",
      "table": "projects"
    },
    {
      "value": "length(\"id\") between 5 and 128 and \"id\" glob 'icp_*'",
